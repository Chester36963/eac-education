          "questions": [
            {
              "id": "poly-cal-001",
              "subcategory": "factorisation",
              "skill": "common-factor",
              "questionType": "mcq",
              "difficulty": "easy",
              "stem": "Factorise 6x² − 9x.",
              "stemZh": "分解因式：6x² − 9x。",
              "options": {
                "A": "3x(2x − 3)",
                "B": "3(2x − 3)",
                "C": "x(6x − 3)",
                "D": "3x(2x + 3)"
              },
              "optionsZh": {
                "A": "3x(2x − 3)",
                "B": "3(2x − 3)",
                "C": "x(6x − 3)",
                "D": "3x(2x + 3)"
              },
              "answer": "A",
              "hint": "Take out the greatest common factor of both terms.",
              "hintZh": "提出兩項的最大公因式。",
              "solution": "The greatest common factor is 3x. Hence 6x² − 9x = 3x(2x − 3).",
              "solutionZh": "最大公因式是 3x，所以 6x² − 9x = 3x(2x − 3)。",
              "source": "EAC original practice",
              "sourceZh": "EAC 原創練習",
              "level": "free"
            },
            {
              "id": "poly-cal-002",
              "subcategory": "factorisation",
              "skill": "quadratic-factorisation",
              "questionType": "mcq",
              "difficulty": "medium",
              "stem": "Factorise x² + 5x + 6.",
              "stemZh": "分解因式：x² + 5x + 6。",
              "options": {
                "A": "(x + 1)(x + 6)",
                "B": "(x + 2)(x + 3)",
                "C": "(x − 2)(x − 3)",
                "D": "(x + 2)(x − 3)"
              },
              "optionsZh": {
                "A": "(x + 1)(x + 6)",
                "B": "(x + 2)(x + 3)",
                "C": "(x − 2)(x − 3)",
                "D": "(x + 2)(x − 3)"
              },
              "answer": "B",
              "hint": "Find two numbers whose sum is 5 and product is 6.",
              "hintZh": "找出兩個數，使它們的和為 5，積為 6。",
              "solution": "2 + 3 = 5 and 2 × 3 = 6. Thus x² + 5x + 6 = (x + 2)(x + 3).",
              "solutionZh": "2 + 3 = 5，2 × 3 = 6，所以 x² + 5x + 6 = (x + 2)(x + 3)。",
