          "questions": [
            {
              "id": "fc-cal-001",
              "difficulty": "medium",
              "stem": "Given triangle ABC with A(0,0), B(4,0), C(2,3). Find the coordinates of the circumcentre.",
              "stemZh": "已知三角形ABC，其中A(0,0), B(4,0), C(2,3)。求外心的坐標。",
              "options": {
                "A": "(2, 1.5)",
                "B": "(2, 2)",
                "C": "(2, 5/6)",
                "D": "(1.5, 1.5)"
              },
              "optionsZh": {
                "A": "(2, 1.5)",
                "B": "(2, 2)",
                "C": "(2, 5/6)",
                "D": "(1.5, 1.5)"
              },
              "answer": "C",
              "hint": "The circumcentre is equidistant from all three vertices.",
              "hintZh": "外心到三個頂點的距離相等。",
              "solution": "The perpendicular bisector of AB is x = 2. Put O = (2, y). Since OA² = OC², 4 + y² = (3 − y)², giving 6y = 5. Hence O = (2, 5/6).",
              "solutionZh": "AB 的垂直平分線為 x = 2。設 O = (2, y)，由 OA² = OC²，得 4 + y² = (3 − y)²，所以 6y = 5，外心為 (2, 5/6)。",
              "level": "free",
              "subcategory": "circumcentre",
              "skill": "coordinate-method",
              "questionType": "mcq",
              "source": "EAC original practice",
              "sourceZh": "EAC 原創練習"
            },
            {
              "id": "fc-cal-002",
              "subcategory": "centroid",
              "skill": "coordinate-method",
              "questionType": "mcq",
              "difficulty": "medium",
              "stem": "A triangle has vertices (0, 0), (6, 0), (0, 9). Find its centroid.",
              "stemZh": "三角形的頂點為 (0, 0)、(6, 0)、(0, 9)。求重心坐標。",
              "options": {
                "A": "(3, 4.5)",
                "B": "(6, 9)",
                "C": "(2, 3)",
                "D": "(3, 3)"
              },
              "optionsZh": {
                "A": "(3, 4.5)",
                "B": "(6, 9)",
                "C": "(2, 3)",
                "D": "(3, 3)"
              },
              "answer": "C",
              "hint": "Average the three x-coordinates and then the three y-coordinates.",
              "hintZh": "分別求三個 x 坐標及三個 y 坐標的平均值。",
              "solution": "G = ((0 + 6 + 0)/3, (0 + 0 + 9)/3) = (2, 3).",
              "solutionZh": "G = ((0 + 6 + 0)/3, (0 + 0 + 9)/3) = (2, 3)。",
              "source": "EAC original practice",
              "sourceZh": "EAC 原創練習",
              "level": "free"
            },
            {
