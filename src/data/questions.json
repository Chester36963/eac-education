          "questions": [
            {
              "id": "fc-proof-001",
              "difficulty": "hard",
              "stem": "Which theorem directly explains why the midpoint of the hypotenuse is the circumcentre of a right triangle?",
              "stemZh": "哪個定理可直接解釋為何直角三角形的斜邊中點是外心？",
              "options": {
                "A": "Use the property of the inscribed angle",
                "B": "Use the theorem about angles in a semicircle",
                "C": "Use Pythagoras theorem",
                "D": "Use the distance formula"
              },
              "optionsZh": {
                "A": "使用內接角的性質",
                "B": "使用半圓中角的定理",
                "C": "使用勾股定理",
                "D": "使用距離公式"
              },
              "answer": "B",
              "hint": "Think of the hypotenuse as the diameter of a circle.",
              "hintZh": "以斜邊作圓的直徑。",
              "solution": "Draw the circle with the hypotenuse as diameter. Its semicircle subtends a right angle, so the right-angle vertex lies on this circle. All three vertices lie on the circle; its centre is the midpoint of the hypotenuse.",
              "solutionZh": "以斜邊為直徑作圓。由半圓內的圓周角為直角，直角頂點在此圓上，故三個頂點共圓；圓心就是斜邊中點。",
              "level": "free",
              "subcategory": "circumcentre",
              "skill": "right-triangle-property",
              "questionType": "mcq",
              "source": "EAC original practice",
              "sourceZh": "EAC 原創練習"
            }
          ]
        }
